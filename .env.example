# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/quiz_app

# Long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

PORT=3000

# Optional: comma-separated list of allowed origins if the frontend is hosted elsewhere
# CORS_ORIGIN=http://localhost:3000

# ---------- Live exam proctoring (WebRTC) ----------
# STUN works on most networks. Add a TURN server if candidates sit behind strict
# firewalls (school/office networks) and admins see "Connecting" forever.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---------- Sign in with Google (optional) ----------
# Create an OAuth Client ID (Web application) at console.cloud.google.com
# and add http://localhost:3000 to "Authorised JavaScript origins".
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# ---------- Email sign-in codes (optional) ----------
# Without these, codes are printed in the server terminal (fine for development).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Quiz App <you@gmail.com>"
